APP_ENV=development
BRAND_MONITOR_DB_PATH=data/ai_brand_monitor.db

# The application starts fully offline. Gemini requires an explicit opt-in.
AI_PROVIDER=deterministic
# After confirming free-tier availability for your model/project:
# AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite
AI_API_KEY=

# Positive finite HTTPX timeout per network phase (not a total wall-clock deadline).
AI_TIMEOUT_SECONDS=45

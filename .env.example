APP_ENV=development
BRAND_MONITOR_DB_PATH=data/ai_brand_monitor.db

# Default is fully offline and deterministic.
AI_PROVIDER=deterministic
# Set AI_PROVIDER=gemini to enable real inference.
# Obtain a key from Google AI Studio; do not commit your real key.
AI_API_KEY=
# Explicitly choose a currently available model for your account.
AI_MODEL=
